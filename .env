ENV_FOR_DYNACONF=development
MLAPI_APP_NAME=ML API
MLAPI_APP_ENV=development
MLAPI_ML_MODEL_VERSION=v1.0.0

# sqlite | azure_sql
MLAPI_SQL_BACKEND=sqlite
MLAPI_SQL_CONNECTION_STRING=sqlite:///./ml_api.db

# Used when MLAPI_SQL_BACKEND=azure_sql
MLAPI_AZURE_SQL_SERVER=
MLAPI_AZURE_SQL_DATABASE=
MLAPI_AZURE_SQL_USERNAME=
MLAPI_AZURE_SQL_PASSWORD=
MLAPI_AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
MLAPI_AZURE_SQL_CONNECTION_STRING=

MLAPI_BLOB_ACCOUNT_URL=
MLAPI_BLOB_CONTAINER_NAME=ml-models
MLAPI_BLOB_MODEL_PATH=models/pricing_model.pkl
MLAPI_REST_CLIENT_BASE_URL=http://localhost:8000
MLAPI_MCP_ENDPOINT=http://127.0.0.1:8080/mcp
MLAPI_MCP_TRANSPORT=http
MLAPI_MCP_SERVER_NAME=pricing-mcp
MLAPI_MCP_TOOL_NAME=get_pricing_context
MLAPI_MCP_TIMEOUT_SECONDS=30
